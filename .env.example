# Set exactly one extraction route as appropriate.
# GOOGLE_API_KEY=replace-me

# Local Ollama defaults
OLLAMA_BASE_URL=http://localhost:11434
LOCAL_LLM_MODEL=gemma4:4b

# Optional cloud model override
GEMINI_MODEL=gemini-3-flash-preview

# Parsing licensed standards stores their full text. Set true only when you have permission.
LICENSED_STANDARD_STORAGE_ALLOWED=false

# Optional extraction sizing default
EXTRACTION_MAX_UNIT_CHARS=1500
