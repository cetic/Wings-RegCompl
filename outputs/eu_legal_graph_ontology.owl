    <!-- Worked example: the graph's Art. 13 manufacturer obligation, in OWL form -->
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#n_manufacturer">
        <rdf:type rdf:resource="http://example.org/eu-reg#cra_Manufacturer"/>
        <rdfs:label xml:lang="en">Manufacturer</rdfs:label>
        <eureg:name>Manufacturer</eureg:name>
        <eureg:definitionRef>Art. 3(13)</eureg:definitionRef>
        <eureg:manufactures rdf:resource="http://example.org/eu-reg#n_product_digital_elements"/>
        <eureg:hasObligation rdf:resource="http://example.org/eu-reg#obl_1"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#n_product_digital_elements">
        <rdf:type rdf:resource="http://example.org/eu-reg#cra_ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">Product with digital elements</rdfs:label>
        <eureg:name>Product with digital elements</eureg:name>
        <eureg:definitionRef>Art. 3(1)</eureg:definitionRef>
        <eureg:mustComplyWith rdf:resource="http://example.org/eu-reg#n_essential_req_part_i"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#n_essential_req_part_i">
        <rdf:type rdf:resource="http://example.org/eu-reg#cra_ProductPropertyRequirement"/>
        <rdfs:label xml:lang="en">Essential cybersecurity requirements - Part I</rdfs:label>
        <eureg:legalBasis>Annex I, Part I</eureg:legalBasis>
        <eureg:specifiedBy rdf:resource="http://example.org/eu-reg#ref_AnnexI_PartI"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#ref_AnnexI_PartI">
        <rdf:type rdf:resource="http://example.org/eu-reg#ArticleRef"/>
        <rdfs:label xml:lang="en">Annex I, Part I</rdfs:label>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#obl_1">
        <rdf:type rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">Art. 13(1) - ensure essential cybersecurity requirements</rdfs:label>
        <eureg:paragraphRef>Art. 13(1)</eureg:paragraphRef>
        <eureg:action>Ensure product designed, developed and produced in accordance with essential cybersecurity requirements (Annex I Part I)</eureg:action>
        <eureg:trigger>Placing a product with digital elements on the market</eureg:trigger>
        <eureg:relatesTo rdf:resource="http://example.org/eu-reg#n_product_digital_elements"/>
        <eureg:relatesTo rdf:resource="http://example.org/eu-reg#n_essential_req_part_i"/>
    </owl:NamedIndividual>

    <!-- Cross-regulation: CRA security requirements relate to GDPR Art. 32 & Part-IS ISMS -->
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#prov_CRA_EssentialReq">
        <rdf:type rdf:resource="http://example.org/eu-reg#cra_ProductPropertyRequirement"/>
        <rdfs:label xml:lang="en">CRA Annex I essential cybersecurity requirements</rdfs:label>
        <eureg:relatedProvision rdf:resource="http://example.org/eu-reg#prov_GDPR_Art32"/>
        <eureg:relatedProvision rdf:resource="http://example.org/eu-reg#prov_PartIS_ISMS"/>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#prov_GDPR_Art32">
        <rdf:type rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">GDPR Art. 32 security of processing</rdfs:label>
        <eureg:legalSource>GDPR Art. 32</eureg:legalSource>
    </owl:NamedIndividual>
    <owl:NamedIndividual rdf:about="http://example.org/eu-reg#prov_PartIS_ISMS">
        <rdf:type rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">Part-IS IS.I.OR.200 establish an ISMS</rdfs:label>
        <eureg:legalSource>Part-IS IS.I.OR.200</eureg:legalSource>
    </owl:NamedIndividual>

