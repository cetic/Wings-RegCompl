    <!-- Cross-regulation alignment -->
    <owl:ObjectProperty rdf:about="http://example.org/eu-reg#deemsCompliantWith">
        <rdfs:domain rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:range rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">deems compliant with</rdfs:label>
        <skos:definition xml:lang="en">Fulfilling the subject provision is deemed to satisfy the object provision in another act (presumption of conformity / equivalence).</skos:definition>
        <eureg:graphRelType>DEEMS_COMPLIANT_WITH</eureg:graphRelType>
