<?xml version="1.0"?>
<!--

  EU Multi-Regulation Compliance Ontology (EURIO)
  ===============================================

  Modelled in the style of the official EUR-Lex / ELI Metadata Ontology
  (http://data.europa.eu/eli/ontology#)


  This ontology encodes that meta-model directly:
    * each graph node `label`     -> an owl:Class (the category)            via eureg:graphLabel
    * each graph node `sub_label` -> an owl:Class rdfs:subClassOf the label  via eureg:graphSubLabel
    * each relationship `type`    -> an owl:ObjectProperty                  via eureg:graphRelType
    * each node `properties` key  -> an owl:DatatypeProperty
    * Obligation / ComplianceAction / ArticleRef -> first-class classes

  HOW IT STAYS MULTI-REGULATION
  =============================
  The category layer (Actor, RegulatedProduct, SecurityConcept, LegalProvision,
  ComplianceArtifact, ...) is regulation-neutral. Each act is one individual of
  eli:LegalResource. The CRA, GDPR and Part-IS sub_labels are provided as
  examples; new regulations are onboarded by adding sub_label classes and
  attaching eureg:legalSource / eureg:regulationCode annotations - the core is
  untouched.

  Serialization : RDF/XML
  Base namespace: http://example.org/eu-reg#   (prefix: eureg)
  Backbone      : ELI 1.5 (imported)            (prefix: eli)
  ============================================================================
-->
<rdf:RDF xmlns="http://example.org/eu-reg#"
     xml:base="http://example.org/eu-reg"
     xmlns:eureg="http://example.org/eu-reg#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dct="http://purl.org/dc/terms/"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:eli="http://data.europa.eu/eli/ontology#">

    <owl:Ontology rdf:about="http://example.org/eu-reg#">
        <owl:imports rdf:resource="http://data.europa.eu/eli/ontology#"/>
        <vann:preferredNamespacePrefix>eureg</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>http://example.org/eu-reg#</vann:preferredNamespaceUri>
        <rdfs:label xml:lang="en">EU Multi-Regulation Compliance Ontology (EURIO)</rdfs:label>
        <dct:title xml:lang="en">EU Multi-Regulation Compliance Ontology (EURIO)</dct:title>
        <dct:description xml:lang="en">A regulation-agnostic ontology describing EU legislative acts and their compliance obligations. It extends the ELI Metadata Ontology with a domain layer that mirrors the Neo4j property graph generated by this project (node label/sub_label taxonomy, typed relationships, and Obligation / ComplianceAction / cross-reference nodes). Illustrated with the Cyber Resilience Act (EU 2024/2847), the GDPR (EU 2016/679) and aviation Part-IS (EU 2023/203).</dct:description>
        <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <owl:versionInfo rdf:datatype="http://www.w3.org/2001/XMLSchema#string">1.0.0</owl:versionInfo>
        <rdfs:seeAlso rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <skos:editorialNote xml:lang="en">Design rationale. (1) The document layer reuses ELI (eli:LegalResource, eli:LegalResourceSubdivision and the eli:has_part / eli:is_part_of backbone) so that acts and their articles/annexes/recitals are described with the official EUR-Lex vocabulary. (2) The domain layer is a faithful OWL rendering of the project's graph schema: the recurring node `label` values become category classes annotated with eureg:graphLabel, the `sub_label` values become their subclasses annotated with eureg:graphSubLabel, relationship `type` strings become object properties annotated with eureg:graphRelType, and the `properties` keys become datatype properties. (3) Obligation, ComplianceAction and ArticleRef are modelled as first-class entities exactly as the ingestion script materialises them.</skos:editorialNote>
    </owl:Ontology>

    <owl:AnnotationProperty rdf:about="http://example.org/eu-reg#legalSource">
        <rdfs:label xml:lang="en">legal source</rdfs:label>
        <rdfs:comment xml:lang="en">Citation of the provision grounding a term (article, annex, recital, point). Regulation-agnostic generalisation of the graph property keys `cra_definition_id`, `article_ref` and `legal_basis`.</rdfs:comment>
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/eu-reg#regulationCode">
        <rdfs:label xml:lang="en">regulation code</rdfs:label>
        <rdfs:comment xml:lang="en">Short identifier of the originating act (CRA, GDPR, Part-IS, ...). Regulation-neutral core terms omit it.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/eu-reg#graphLabel">
        <rdfs:label xml:lang="en">graph label</rdfs:label>
        <rdfs:comment xml:lang="en">The primary Neo4j node label (the `label` field) this class corresponds to.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/eu-reg#graphSubLabel">
        <rdfs:label xml:lang="en">graph sub-label</rdfs:label>
        <rdfs:comment xml:lang="en">The secondary Neo4j node label (the `sub_label` field) this class corresponds to.</rdfs:comment>
    </owl:AnnotationProperty>

    <owl:AnnotationProperty rdf:about="http://example.org/eu-reg#graphRelType">
        <rdfs:label xml:lang="en">graph relationship type</rdfs:label>
        <rdfs:comment xml:lang="en">The Neo4j relationship type (the `type` field) this object property corresponds to.</rdfs:comment>
    </owl:AnnotationProperty>

    <!-- LAYER 1 - DOCUMENT STRUCTURE (ELI-ALIGNED) -->

    <owl:Class rdf:about="http://example.org/eu-reg#LegalAct">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResource"/>
        <rdfs:label xml:lang="en">Legal Act</rdfs:label>
        <skos:definition xml:lang="en">Any binding EU legislative instrument, described as an ELI legal resource. Mirrors the graph's `Article.regulation` envelope.</skos:definition>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/eu-reg#Regulation">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalAct"/>
        <rdfs:label xml:lang="en">Regulation</rdfs:label>
        <skos:definition xml:lang="en">A directly applicable EU regulation (TFEU Art. 288).</skos:definition>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/eu-reg#Directive">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalAct"/>
        <rdfs:label xml:lang="en">Directive</rdfs:label>
        <skos:definition xml:lang="en">An EU directive requiring national transposition (TFEU Art. 288).</skos:definition>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/eu-reg#ImplementingAct">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Regulation"/>
        <rdfs:label xml:lang="en">Implementing Act</rdfs:label>
        <skos:definition xml:lang="en">A Commission implementing regulation (TFEU Art. 291), e.g. Part-IS.</skos:definition>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/eu-reg#DelegatedAct">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Regulation"/>
        <rdfs:label xml:lang="en">Delegated Act</rdfs:label>
        <skos:definition xml:lang="en">A Commission delegated regulation (TFEU Art. 290).</skos:definition>
    </owl:Class>

    <!-- Subdivisions: the graph's ArticleRef targets ("Art. 13", "Annex I", ...) -->
    <owl:Class rdf:about="http://example.org/eu-reg#Article">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">Article</rdfs:label>
        <eureg:graphLabel>Article</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Annex">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">Annex</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Recital">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">Recital</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Chapter">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">Chapter</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Point">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">Point</rdfs:label>
        <skos:definition xml:lang="en">A numbered or lettered point/paragraph within an article or annex.</skos:definition>
    </owl:Class>

    <!-- ArticleRef: the virtual cross-reference target node materialised by the graph -->
    <owl:Class rdf:about="http://example.org/eu-reg#ArticleRef">
        <rdfs:subClassOf rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">Article Reference</rdfs:label>
        <skos:definition xml:lang="en">A lightweight reference to a provision targeted by a cross-reference (the graph's :ArticleRef node, keyed on `ref`).</skos:definition>
        <eureg:graphLabel>ArticleRef</eureg:graphLabel>
    </owl:Class>

    <!-- LAYER 2 - GRAPH NODE CATEGORIES  (the `label` taxonomy)
         Regulation-neutral category classes. sub_label classes follow below. -->

    <!-- ===== Actor ===== -->
    <owl:Class rdf:about="http://example.org/eu-reg#Actor">
        <rdfs:label xml:lang="en">Actor</rdfs:label>
        <skos:definition xml:lang="en">Any natural person, legal person or body addressed by, or acting under, a legal act.</skos:definition>
        <eureg:graphLabel>Actor</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#RegulatedEntity">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Actor"/>
        <rdfs:label xml:lang="en">Regulated Entity</rdfs:label>
        <skos:definition xml:lang="en">A duty-bearer on whom the act imposes obligations (economic operator, controller, organisation).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#NaturalPerson">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Actor"/>
        <rdfs:label xml:lang="en">Natural Person</rdfs:label>
        <skos:definition xml:lang="en">An individual, typically a beneficiary of rights (user, consumer, data subject).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Authority">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Actor"/>
        <rdfs:label xml:lang="en">Authority</rdfs:label>
        <skos:definition xml:lang="en">A public or institutional body with powers under the act (supervision, enforcement, notification, standardisation).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#SupervisoryAuthority">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Authority"/>
        <rdfs:label xml:lang="en">Supervisory Authority</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#CompetentAuthority">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Authority"/>
        <rdfs:label xml:lang="en">Competent Authority</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#ConformityAssessmentBody">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Authority"/>
        <rdfs:label xml:lang="en">Conformity Assessment Body</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#UnionBody">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Authority"/>
        <rdfs:label xml:lang="en">Union Body</rdfs:label>
        <skos:definition xml:lang="en">An EU-level institution, agency or board (Commission, ENISA, EDPB, EASA, ...).</skos:definition>
    </owl:Class>

    <!-- Enterprise (size classification) -->
    <owl:Class rdf:about="http://example.org/eu-reg#Enterprise">
        <rdfs:label xml:lang="en">Enterprise</rdfs:label>
        <skos:definition xml:lang="en">Size classification of an undertaking (Recommendation 2003/361/EC), affecting obligations and fines.</skos:definition>
        <eureg:graphLabel>Enterprise</eureg:graphLabel>
    </owl:Class>

    <!-- RegulatedObject / Product -->
    <owl:Class rdf:about="http://example.org/eu-reg#RegulatedObject">
        <rdfs:label xml:lang="en">Regulated Object</rdfs:label>
        <skos:definition xml:lang="en">The thing an act regulates: a product, system, service, asset or activity.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#RegulatedProduct">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#RegulatedObject"/>
        <rdfs:label xml:lang="en">Regulated Product</rdfs:label>
        <skos:definition xml:lang="en">A product placed or made available on the market under the act. Generalises the graph label `ProductWithDigitalElements`.</skos:definition>
        <eureg:graphLabel>ProductWithDigitalElements</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#ProductCategory">
        <rdfs:label xml:lang="en">Product Category</rdfs:label>
        <skos:definition xml:lang="en">A risk/criticality classification of products driving the applicable conformity route.</skos:definition>
        <eureg:graphLabel>ProductCategory</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#ProductComponent">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#RegulatedObject"/>
        <rdfs:label xml:lang="en">Product Component</rdfs:label>
        <skos:definition xml:lang="en">A software or hardware component integrated into a regulated product.</skos:definition>
        <eureg:graphLabel>ProductComponent</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#InformationSystem">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#RegulatedObject"/>
        <rdfs:label xml:lang="en">Information System</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#MarketActivity">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#RegulatedObject"/>
        <rdfs:label xml:lang="en">Market Activity</rdfs:label>
        <skos:definition xml:lang="en">A regulated activity affecting an object's market status (placing on the market, withdrawal, recall, processing).</skos:definition>
        <eureg:graphLabel>MarketActivity</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#UseContext">
        <rdfs:label xml:lang="en">Use Context</rdfs:label>
        <skos:definition xml:lang="en">The intended purpose and reasonably foreseeable use/misuse framing the scope of obligations.</skos:definition>
        <eureg:graphLabel>UseContext</eureg:graphLabel>
    </owl:Class>

    <!-- TechnicalConcept -->
    <owl:Class rdf:about="http://example.org/eu-reg#TechnicalConcept">
        <rdfs:label xml:lang="en">Technical Concept</rdfs:label>
        <skos:definition xml:lang="en">A technical artefact or notion referenced by the act (SBOM, endpoint, connection, remote data processing).</skos:definition>
        <eureg:graphLabel>TechnicalConcept</eureg:graphLabel>
    </owl:Class>

    <!-- SecurityConcept (generalises CybersecurityConcept) -->
    <owl:Class rdf:about="http://example.org/eu-reg#SecurityConcept">
        <rdfs:label xml:lang="en">Security Concept</rdfs:label>
        <skos:definition xml:lang="en">Umbrella for risk, threat, vulnerability, incident, protective property and mitigating measure. Generalises the graph label `CybersecurityConcept`.</skos:definition>
        <eureg:graphLabel>CybersecurityConcept</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Risk">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Risk</rdfs:label>
        <skos:definition xml:lang="en">The potential for loss or harm from a threat exploiting a vulnerability.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Threat">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Threat</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Vulnerability">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Vulnerability</rdfs:label>
        <skos:definition xml:lang="en">A weakness that can be exploited by a threat.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Incident">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Incident</rdfs:label>
        <skos:definition xml:lang="en">An event compromising a security property or causing harm; usually triggers reporting obligations.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#SecurityMeasure">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Security Measure</rdfs:label>
        <skos:definition xml:lang="en">A technical or organisational control that mitigates risk (e.g. a security update).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#SecurityProperty">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Security Property</rdfs:label>
        <skos:definition xml:lang="en">A protective property to be preserved (confidentiality, integrity, availability, authenticity).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#ManagementSystem">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#SecurityConcept"/>
        <rdfs:label xml:lang="en">Management System</rdfs:label>
        <skos:definition xml:lang="en">An organised framework of policies, processes and controls (e.g. an ISMS).</skos:definition>
    </owl:Class>

    <!-- ComplianceArtifact -->
    <owl:Class rdf:about="http://example.org/eu-reg#ComplianceArtifact">
        <rdfs:label xml:lang="en">Compliance Artifact</rdfs:label>
        <skos:definition xml:lang="en">Any tangible evidence, documentation, marking, certificate or standard demonstrating compliance.</skos:definition>
        <eureg:graphLabel>ComplianceArtifact</eureg:graphLabel>
    </owl:Class>

    <!-- LegalProvision (normative content) -->
    <owl:Class rdf:about="http://example.org/eu-reg#LegalProvision">
        <rdfs:label xml:lang="en">Legal Provision</rdfs:label>
        <skos:definition xml:lang="en">The normative content of an act: obligations, requirements, rights, prohibitions, exemptions, principles, penalties, support periods.</skos:definition>
        <eureg:graphLabel>LegalProvision</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Requirement">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Requirement</rdfs:label>
        <skos:definition xml:lang="en">A substantive condition an entity, product or process must satisfy (often detailed in an annex).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Right">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Right</rdfs:label>
        <skos:definition xml:lang="en">An entitlement conferred on a beneficiary (e.g. a data subject right).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Prohibition">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Prohibition</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Exemption">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Exemption</rdfs:label>
        <skos:definition xml:lang="en">A derogation relieving an entity from an obligation under stated conditions.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Principle">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Principle</rdfs:label>
        <skos:definition xml:lang="en">A foundational principle steering interpretation and compliance (e.g. GDPR Art. 5).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#LegalBasis">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Legal Basis</rdfs:label>
        <skos:definition xml:lang="en">A lawful ground legitimising an activity (e.g. a lawful basis for processing).</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#SupportPeriod">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Support Period</rdfs:label>
        <skos:definition xml:lang="en">A defined period during which the regulated entity must maintain/secure the object.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#Penalty">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Penalty</rdfs:label>
        <skos:definition xml:lang="en">A sanction imposed for non-compliance (e.g. an administrative fine).</skos:definition>
    </owl:Class>

    <!-- LegalFramework (links to other regimes) -->
    <owl:Class rdf:about="http://example.org/eu-reg#LegalFramework">
        <rdfs:label xml:lang="en">Legal Framework</rdfs:label>
        <skos:definition xml:lang="en">A cross-cutting regime or instrument referenced by the act (personal data, coordinated vulnerability disclosure, harmonisation legislation).</skos:definition>
        <eureg:graphLabel>LegalFramework</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#InformationAsset">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalFramework"/>
        <rdfs:label xml:lang="en">Information Asset</rdfs:label>
        <skos:definition xml:lang="en">Data or information protected or regulated by the act.</skos:definition>
    </owl:Class>

    <!-- LAYER 3 - GRAPH META-MODEL ENTITIES
         (Obligation, ComplianceAction) -->

    <owl:Class rdf:about="http://example.org/eu-reg#Obligation">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#LegalProvision"/>
        <rdfs:label xml:lang="en">Obligation</rdfs:label>
        <skos:definition xml:lang="en">A mandatory duty borne by an actor, materialised as a first-class :Obligation node (paragraph_ref, action, trigger, deadline) linked to its actor and related nodes.</skos:definition>
        <eureg:graphLabel>Obligation</eureg:graphLabel>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#ReportingObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">Reporting Obligation</rdfs:label>
        <skos:definition xml:lang="en">A duty to notify/report events or information to an authority within a deadline.</skos:definition>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#InformationObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">Information Obligation</rdfs:label>
    </owl:Class>
    <owl:Class rdf:about="http://example.org/eu-reg#RecordKeepingObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">Record-Keeping Obligation</rdfs:label>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/eu-reg#ComplianceAction">
        <rdfs:label xml:lang="en">Compliance Action</rdfs:label>
        <skos:definition xml:lang="en">A short, executable step that helps fulfil an obligation, materialised as a :ComplianceAction node (text, category, priority) linked via HAS_ACTION.</skos:definition>
        <eureg:graphLabel>ComplianceAction</eureg:graphLabel>
    </owl:Class>

    <!-- LAYER 4 - OBJECT PROPERTIES -->

    <!-- Structural (ELI subproperties) -->
    <owl:ObjectProperty rdf:about="http://example.org/eu-reg#hasProvision">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#has_part"/>
        <rdfs:domain rdf:resource="http://example.org/eu-reg#LegalAct"/>
        <rdfs:range rdf:resource="http://data.europa.eu/eli/ontology#LegalResourceSubdivision"/>
        <rdfs:label xml:lang="en">has provision</rdfs:label>
    </owl:ObjectProperty>

    <!-- Graph meta-model edges -->
    <owl:ObjectProperty rdf:about="http://example.org/eu-reg#hasObligation">
        <rdfs:domain rdf:resource="http://example.org/eu-reg#Actor"/>
        <rdfs:range rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">has obligation</rdfs:label>
        <eureg:graphRelType>HAS_OBLIGATION</eureg:graphRelType>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/eu-reg#relatesTo">
        <rdfs:domain rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:label xml:lang="en">relates to</rdfs:label>
        <eureg:graphRelType>RELATES_TO</eureg:graphRelType>
    </owl:ObjectProperty>
    <owl:ObjectProperty rdf:about="http://example.org/eu-reg#hasAction">
        <rdfs:domain rdf:resource="http://example.org/eu-reg#Obligation"/>
        <rdfs:range rdf:resource="http://example.org/eu-reg#ComplianceAction"/>
        <rdfs:label xml:lang="en">has action</rdfs:label>
        <eureg:graphRelType>HAS_ACTION</eureg:graphRelType>
    </owl:ObjectProperty>

    <!-- Cross-reference edges (to ArticleRef) -->
    <owl:ObjectProperty rdf:about="http://example.org/eu-reg#references">
        <rdfs:subPropertyOf rdf:resource="http://data.europa.eu/eli/ontology#refers_to"/>
        <rdfs:range rdf:resource="http://example.org/eu-reg#ArticleRef"/>
        <rdfs:label xml:lang="en">references</rdfs:label>
