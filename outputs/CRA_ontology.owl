        <rdfs:label xml:lang="en">Vulnerability Handling Requirement</rdfs:label>
        <cra:legalSource>Annex I, Part II</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#Obligation">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#LegalProvision"/>
