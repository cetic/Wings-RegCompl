        <cra:legalSource>Art. 3(35)</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#InternationalStandard">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#ComplianceArtifact"/>
        <rdfs:label xml:lang="en">International Standard</rdfs:label>
        <cra:legalSource>Art. 3(34)</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#EuropeanCybersecurityCertificate">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#ComplianceArtifact"/>
        <rdfs:label xml:lang="en">European Cybersecurity Certificate</rdfs:label>
        <cra:legalSource>Art. 8, Reg. (EU) 2019/881</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#CommonSpecification">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#ComplianceArtifact"/>
        <rdfs:label xml:lang="en">Common Specification</rdfs:label>
        <cra:legalSource>Art. 27</cra:legalSource>
    </owl:Class>

    
    <!-- Legal Provisions -->
    

