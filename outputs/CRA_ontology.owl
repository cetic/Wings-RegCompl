        <cra:legalSource>Art. 14</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#ImporterObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#Obligation"/>
        <rdfs:label xml:lang="en">Importer Obligation</rdfs:label>
        <cra:legalSource>Art. 19</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#DistributorObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#Obligation"/>
        <rdfs:label xml:lang="en">Distributor Obligation</rdfs:label>
        <cra:legalSource>Art. 20</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#StewardObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#Obligation"/>
        <rdfs:label xml:lang="en">Steward Obligation</rdfs:label>
        <cra:legalSource>Art. 24</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#InformationObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#Obligation"/>
        <rdfs:label xml:lang="en">Information Obligation</rdfs:label>
        <cra:legalSource>Annex II</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#SupportPeriod">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#LegalProvision"/>
        <rdfs:label xml:lang="en">Support Period</rdfs:label>
        <cra:legalSource>Art. 3(20), Art. 13(8)</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#Penalty">
