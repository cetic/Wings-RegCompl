    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#NotifiedBody">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#InstitutionalActor"/>
        <rdfs:label xml:lang="en">Notified Body</rdfs:label>
        <cra:legalSource>Art. 3(29), Art. 39</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#ConformityAssessmentBody">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#InstitutionalActor"/>
        <rdfs:label xml:lang="en">Conformity Assessment Body</rdfs:label>
        <cra:legalSource>Art. 3(28)</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#ADCO">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#InstitutionalActor"/>
        <rdfs:label xml:lang="en">ADCO</rdfs:label>
        <cra:legalSource>Art. 52(15), Art. 13(25)</cra:legalSource>
    </owl:Class>

    
    <!-- Products         -->
    

