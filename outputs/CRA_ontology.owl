    <!-- Object Properties-->

    <owl:ObjectProperty rdf:about="http://example.org/cra#manufactures">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">manufactures</rdfs:label>
        <cra:legalSource>Art. 3(13)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#imports">
        <rdfs:domain rdf:resource="http://example.org/cra#Importer"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">imports</rdfs:label>
        <cra:legalSource>Art. 3(16)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#distributes">
        <rdfs:domain rdf:resource="http://example.org/cra#Distributor"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">distributes</rdfs:label>
        <cra:legalSource>Art. 3(17)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#representsManufacturer">
        <rdfs:domain rdf:resource="http://example.org/cra#AuthorisedRepresentative"/>
        <rdfs:range rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:label xml:lang="en">represents manufacturer</rdfs:label>
        <cra:legalSource>Art. 3(15)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#stewards">
        <rdfs:domain rdf:resource="http://example.org/cra#OpenSourceSoftwareSteward"/>
        <rdfs:range rdf:resource="http://example.org/cra#FreeAndOpenSourceSoftware"/>
        <rdfs:label xml:lang="en">stewards</rdfs:label>
        <cra:legalSource>Art. 3(14)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasComponent">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductComponent"/>
        <rdfs:label xml:lang="en">has component</rdfs:label>
        <cra:legalSource>Art. 3(1), (6)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasRemoteDataProcessing">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#RemoteDataProcessing"/>
        <rdfs:label xml:lang="en">has remote data processing</rdfs:label>
        <cra:legalSource>Art. 3(1), (2)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasConnection">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#Connection"/>
        <rdfs:label xml:lang="en">has connection</rdfs:label>
        <cra:legalSource>Art. 3(8)–(10)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasSBOM">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#SoftwareBillOfMaterials"/>
        <rdfs:label xml:lang="en">has SBOM</rdfs:label>
        <cra:legalSource>Art. 3(39), Annex I Part II(1)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#isSubjectTo">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#ConformityAssessment"/>
        <rdfs:label xml:lang="en">is subject to</rdfs:label>
        <cra:legalSource>Art. 32</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#mustComplyWith">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#EssentialCybersecurityRequirement"/>
        <rdfs:label xml:lang="en">must comply with</rdfs:label>
        <cra:legalSource>Art. 6</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasSupportPeriod">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#SupportPeriod"/>
        <rdfs:label xml:lang="en">has support period</rdfs:label>
        <cra:legalSource>Art. 3(20), Art. 13(8)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasVulnerability">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#Vulnerability"/>
        <rdfs:label xml:lang="en">has vulnerability</rdfs:label>
        <cra:legalSource>Art. 3(40)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#exploits">
        <rdfs:domain rdf:resource="http://example.org/cra#CyberThreat"/>
        <rdfs:range rdf:resource="http://example.org/cra#Vulnerability"/>
        <rdfs:label xml:lang="en">exploits</rdfs:label>
        <cra:legalSource>Art. 3(40), (46)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#causesIncident">
        <rdfs:domain rdf:resource="http://example.org/cra#Vulnerability"/>
        <rdfs:range rdf:resource="http://example.org/cra#Incident"/>
        <rdfs:label xml:lang="en">causes incident</rdfs:label>
        <cra:legalSource>Art. 3(43), (44)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#posesRisk">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#CybersecurityRisk"/>
        <rdfs:label xml:lang="en">poses risk</rdfs:label>
        <cra:legalSource>Art. 3(37)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#addressedBy">
        <rdfs:domain rdf:resource="http://example.org/cra#Vulnerability"/>
        <rdfs:range rdf:resource="http://example.org/cra#SecurityUpdate"/>
        <rdfs:label xml:lang="en">addressed by</rdfs:label>
        <cra:legalSource>Annex I, Part II(2), (8)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#performsAssessment">
        <rdfs:domain rdf:resource="http://example.org/cra#NotifiedBody"/>
        <rdfs:range rdf:resource="http://example.org/cra#ConformityAssessment"/>
        <rdfs:label xml:lang="en">performs assessment</rdfs:label>
        <cra:legalSource>Art. 39, Art. 47</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#notifies">
        <rdfs:domain rdf:resource="http://example.org/cra#NotifyingAuthority"/>
        <rdfs:range rdf:resource="http://example.org/cra#NotifiedBody"/>
        <rdfs:label xml:lang="en">notifies</rdfs:label>
        <cra:legalSource>Art. 35, Art. 43</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#supervisesMarket">
        <rdfs:domain rdf:resource="http://example.org/cra#MarketSurveillanceAuthority"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">supervises market</rdfs:label>
        <cra:legalSource>Art. 52</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#reportsTo">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#CSIRT"/>
        <rdfs:label xml:lang="en">reports to</rdfs:label>
        <cra:legalSource>Art. 14(1)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#reportsToENISA">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#ENISA"/>
        <rdfs:label xml:lang="en">reports to ENISA</rdfs:label>
        <cra:legalSource>Art. 14(1)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#affixesCEMarking">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#CEMarking"/>
        <rdfs:label xml:lang="en">affixes CE marking</rdfs:label>
        <cra:legalSource>Art. 13(12), Art. 30</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#issuesDeclaration">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#EUDeclarationOfConformity"/>
        <rdfs:label xml:lang="en">issues declaration</rdfs:label>
        <cra:legalSource>Art. 13(12), Art. 28</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#producesTechDoc">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#TechnicalDocumentation"/>
        <rdfs:label xml:lang="en">produces technical documentation</rdfs:label>
        <cra:legalSource>Art. 13(12), Art. 31</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#performsRiskAssessment">
        <rdfs:domain rdf:resource="http://example.org/cra#Manufacturer"/>
        <rdfs:range rdf:resource="http://example.org/cra#CybersecurityRiskAssessment"/>
        <rdfs:label xml:lang="en">performs risk assessment</rdfs:label>
        <cra:legalSource>Art. 13(2)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#placesOnMarket">
        <rdfs:domain rdf:resource="http://example.org/cra#EconomicOperator"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">places on market</rdfs:label>
        <cra:legalSource>Art. 3(21)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#makesAvailable">
        <rdfs:domain rdf:resource="http://example.org/cra#EconomicOperator"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:label xml:lang="en">makes available</rdfs:label>
        <cra:legalSource>Art. 3(22)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#hasIntendedPurpose">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#IntendedPurpose"/>
        <rdfs:label xml:lang="en">has intended purpose</rdfs:label>
        <cra:legalSource>Art. 3(23)</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#presumesConformityVia">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#HarmonisedStandard"/>
        <rdfs:label xml:lang="en">presumes conformity via</rdfs:label>
        <cra:legalSource>Art. 27</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#classifiedUnder">
        <rdfs:domain rdf:resource="http://example.org/cra#ProductWithDigitalElements"/>
        <rdfs:range rdf:resource="http://example.org/cra#ProductCategory"/>
        <rdfs:label xml:lang="en">classified under</rdfs:label>
        <cra:legalSource>Art. 7, Art. 8</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#imposedOn">
        <rdfs:domain rdf:resource="http://example.org/cra#Penalty"/>
        <rdfs:range rdf:resource="http://example.org/cra#EconomicOperator"/>
        <rdfs:label xml:lang="en">imposed on</rdfs:label>
        <cra:legalSource>Art. 64</cra:legalSource>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="http://example.org/cra#deemsCompliantWith">
        <rdfs:domain rdf:resource="http://example.org/cra#EssentialCybersecurityRequirement"/>
        <rdfs:range rdf:resource="http://example.org/cra#EssentialCybersecurityRequirement"/>
        <rdfs:label xml:lang="en">deems compliant with</rdfs:label>
        <cra:legalSource>Art. 12 (CRA ↔ AI Act)</cra:legalSource>
    </owl:ObjectProperty>

    
    <!-- Disjointness Axioms                                            -->
    

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://example.org/cra#Manufacturer"/>
            <owl:Class rdf:about="http://example.org/cra#AuthorisedRepresentative"/>
            <owl:Class rdf:about="http://example.org/cra#Importer"/>
            <owl:Class rdf:about="http://example.org/cra#Distributor"/>
        </owl:members>
    </rdf:Description>

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://example.org/cra#DefaultProduct"/>
            <owl:Class rdf:about="http://example.org/cra#ImportantProduct"/>
            <owl:Class rdf:about="http://example.org/cra#CriticalProduct"/>
        </owl:members>
    </rdf:Description>

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://example.org/cra#ImportantProduct_ClassI"/>
            <owl:Class rdf:about="http://example.org/cra#ImportantProduct_ClassII"/>
        </owl:members>
    </rdf:Description>

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://example.org/cra#Software"/>
            <owl:Class rdf:about="http://example.org/cra#Hardware"/>
        </owl:members>
    </rdf:Description>

    <rdf:Description>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#AllDisjointClasses"/>
        <owl:members rdf:parseType="Collection">
            <owl:Class rdf:about="http://example.org/cra#LogicalConnection"/>
            <owl:Class rdf:about="http://example.org/cra#PhysicalConnection"/>
            <owl:Class rdf:about="http://example.org/cra#IndirectConnection"/>
        </owl:members>
    </rdf:Description>

</rdf:RDF>
