        <cra:legalSource>Art. 13</cra:legalSource>
    </owl:Class>

    <owl:Class rdf:about="http://example.org/cra#ReportingObligation">
        <rdfs:subClassOf rdf:resource="http://example.org/cra#Obligation"/>
